# OpsOrigin 环境配置

# Core API
OPSNEXUS_CORE_PORT=8080

# PostgreSQL
OPSNEXUS_POSTGRES_DSN=postgres://opsnexus:opsnexus@localhost:5432/opsnexus?sslmode=disable

# Dgraph
OPSNEXUS_DGRAPH_TARGET=localhost:9080

# Redis (限流熔断器)
OPSNEXUS_REDIS_ADDR=localhost:6379

# JWT 密钥 (生产环境请更换)
OPSNEXUS_JWT_SECRET=change-me-to-a-random-64-char-string

# 隧道注册共享密钥 (Proxy 与 Core 必须一致, 未配置则拒绝 Proxy 注册)
OPSNEXUS_TUNNEL_AUTH_SECRET=change-me-to-another-random-64-char-string
# 仅本地测试可临时设为 true 跳过隧道认证(会明文告警), 生产必须为 false
OPSNEXUS_TUNNEL_INSECURE=false

# Outbox
OPSNEXUS_OUTBOX_POLL_INTERVAL=1s
OPSNEXUS_OUTBOX_BATCH_SIZE=100
