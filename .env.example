# OpsOrigin 环境配置

# 运行环境: development | production (默认 development)
# production 下启动时会强制校验凭据强度, 默认/占位/过短密钥直接拒绝启动 (fail-fast)。
OPSORIGIN_ENV=development

# Core API
OPSORIGIN_CORE_PORT=8080

# PostgreSQL
OPSORIGIN_POSTGRES_DSN=postgres://opsorigin:opsorigin@localhost:5432/opsorigin?sslmode=disable

# Dgraph
OPSORIGIN_DGRAPH_TARGET=localhost:9080

# Redis (限流熔断器)
OPSORIGIN_REDIS_ADDR=localhost:6379

# JWT 密钥 (生产环境请更换)
OPSORIGIN_JWT_SECRET=change-me-to-a-random-64-char-string

# 隧道注册共享密钥 (Proxy 与 Core 必须一致, 未配置则拒绝 Proxy 注册)
OPSORIGIN_TUNNEL_AUTH_SECRET=change-me-to-another-random-64-char-string
# 仅本地测试可临时设为 true 跳过隧道认证(会明文告警), 生产必须为 false
OPSORIGIN_TUNNEL_INSECURE=false

# Outbox
OPSORIGIN_OUTBOX_POLL_INTERVAL=1s
OPSORIGIN_OUTBOX_BATCH_SIZE=100
