# OpsOrigin Core — systemd unit 示例(单机部署, 自愈 + 开机自启)
# ---------------------------------------------------------------
# 安装:
#   1) 编译并安装二进制:
#        make build && sudo install -m 0755 bin/core /usr/local/bin/opsorigin-core
#   2) 环境文件(从 .env 复制并填写生产密钥):
#        sudo cp .env.example /etc/opsorigin/core.env
#        sudoedit /etc/opsorigin/core.env   # 必须替换 OPSORIGIN_JWT_SECRET 等占位密钥
#   3) 安装本 unit:
#        sudo install -m 0644 deploy/systemd/opsorigin-core.service /etc/systemd/system/
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now opsorigin-core
#   4) 观察日志: journalctl -u opsorigin-core -f
#
# 说明: EnvironmentFile 中 OPSORIGIN_ENV=production 会触发凭据强度
# 校验(fail-fast), 占位/过短密钥将导致启动失败, 这是有意的安全行为。
[Unit]
Description=OpsOrigin Core (中心控制面)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opsorigin
Group=opsorigin
EnvironmentFile=/etc/opsorigin/core.env
ExecStart=/usr/local/bin/opsorigin-core
Restart=on-failure
RestartSec=5s
# 硬性资源限制, 防失控
LimitNOFILE=65535
TimeoutStopSec=30s
# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opsorigin
PrivateTmp=true

[Install]
WantedBy=multi-user.target
