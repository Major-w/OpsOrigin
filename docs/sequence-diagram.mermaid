%% ① 启动接线：provider 注册 + Service 接入 Core mux
sequenceDiagram
    autonumber
    participant Main as cmd/core/main.go
    participant All as providers/all (blank import)
    participant Reg as cloud.registry
    participant Srv as Server (Core)
    participant Svc as cloud.Service

    Main->>All: import _ "internal/cloud/providers/all"
    All->>Reg: init() → cloud.Register(aws/tencent/aliyun/huawei)
    Reg-->>All: providers 已注册 (Names() 非空)
    Main->>Svc: NewService(store, cloudCMDBAdapter{pgRepo, cmdbSvc})
    Main->>Srv: server.RegisterService(cloudSvc)
    Srv->>Svc: RegisterRoutes(mux)
    Note over Srv: 自动叠加 auth→audit→rbac 中间件链

%% ② 发现资源：前端 → cloudSvc → provider
sequenceDiagram
    autonumber
    participant FE as 前端云 tab
    participant Svc as cloud.Service
    participant CW as cloud.Get(provider)
    participant P as Provider (aws/...)
    participant Cred as Store / 请求体

    FE->>Svc: POST /api/v1/cloud/resources/list {provider,region,types,cred}
    Svc->>Cred: resolveCredential(req)
    Svc->>CW: cloud.Get(provider)
    CW-->>Svc: Provider 实例
    Svc->>P: ListResources(ctx, cred, region, kinds)
    P-->>Svc: []Resource (VM/DB/LB)
    Svc-->>FE: 200 {resources: Resource[]}

%% ③ 同步 CMDB：前端 → cloudSvc → 适配器 → cmdb.Service → 事件链
sequenceDiagram
    autonumber
    participant FE as 前端云 tab
    participant Svc as cloud.Service
    participant W as CMDBWriter (cloudCMDBAdapter)
    participant PG as pg.Repository
    participant CMDB as cmdb.Service
    participant Out as outbox / monitorTopo

    FE->>Svc: POST /api/v1/cloud/resources/sync {provider,region,types,resources?}
    Svc->>W: SyncResources(ctx, tenantID, resources)
    W->>PG: ListCI(tenant, typeID)  // 去重索引
    PG-->>W: 已有 CI (按 resource_id)
    loop 每个 Resource
        alt 已存在
            W->>CMDB: UpdateCI(ci, WeightDiscovery)
        else 不存在
            W->>CMDB: CreateCI(ci, traceID)
        end
    end
    CMDB->>Out: 写 cmdb_ci + outbox 事件
    Out->>Out: dgraph 同步 + monitorTopo.RecordTenant(ciID, tenantID)
    W-->>Svc: SyncResult{created,updated,skipped,failed,errors}
    Svc-->>FE: 200 SyncResult
